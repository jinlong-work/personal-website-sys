        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.jinlong</groupId>
            <artifactId>personal-website-system</artifactId>
            <version>0.0.1-SNAPSHOT</version>
