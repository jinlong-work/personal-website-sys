{
  "openapi": "3.0.3",
  "info": {
    "title": "\u53ea\u542bPOST /login\u7684\u767b\u5f55\u63a5\u53e3",
    "version": "1.2.0",
    "description": "\u6b64\u6587\u4ef6\u53ea\u67091\u4e2a\u63a5\u53e3\uff1aPOST /login\u3002\u767b\u5f55\u524d\u4ece/captchaImage\u83b7\u53d6uuid\u548c\u9a8c\u8bc1\u7801\u56fe\u7247\uff1b\u9a8c\u8bc1\u7801\u5173\u95ed\u65f6\u53ef\u7701\u7565code\u548cuuid\u3002"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "name": "\u767b\u5f55\u63a5\u53e3"
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "tags": [
          "\u767b\u5f55\u63a5\u53e3"
        ],
        "operationId": "personalWebsiteLoginOnly",
        "summary": "\u7528\u6237\u767b\u5f55 POST /login",
        "description": "Content-Type: application/json\uff0c\u65e0\u9700Token\u3002\n\u9a8c\u8bc1\u7801\u5f00\u542f\u65f6\u5148\u8c03\u7528/captchaImage\uff0c\u4f7f\u7528\u5176uuid\u53ca\u56fe\u7247\u7b54\u6848\uff1b\u5173\u95ed\u65f6\u53ea\u9700username\u548cpassword\u3002\n\u5bc6\u7801\u81f3\u5c115\u4e2a\u5b57\u7b26\u3001UTF-8\u7f16\u7801\u4e0d\u8d85\u8fc772\u5b57\u8282\u3002\u9ed8\u8ba45\u6b21\u5bc6\u7801\u9519\u8bef\u540e\u9650\u523610\u5206\u949f\u3002\n\u767b\u5f55\u6210\u529f\u540e\u590d\u5236\u9876\u5c42token\uff0c\u5728\u540e\u7eed\u63a5\u53e3Bearer\u8ba4\u8bc1\u4e2d\u586b\u5165\u539f\u59cbToken\uff0c\u5de5\u5177\u4f1a\u62fc\u63a5Bearer\u524d\u7f00\u3002\n\u9a8c\u8bc1\u7801\u5728\u8d26\u53f7\u5bc6\u7801\u6821\u9a8c\u4e4b\u524d\u9a8c\u8bc1\u5e76\u6d88\u8d39\uff1b\u8d26\u53f7\u5bc6\u7801\u5931\u8d25\u540e\u4e5f\u8981\u91cd\u65b0\u83b7\u53d6\u9a8c\u8bc1\u7801\u3002",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100,
                    "example": "admin",
                    "description": "\u767b\u5f55\u8d26\u53f7\uff0c2\uff5e100\u4e2a\u5b57\u7b26\uff0c\u5927\u5c0f\u5199\u4e0d\u654f\u611f\uff0c\u4e0d\u5141\u8bb8\u4e24\u7aef\u7a7a\u767d\u3002"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 5,
                    "description": "\u6700\u591a72\u4e2aUTF-8\u5b57\u8282"
                  },
                  "code": {
                    "type": "string",
                    "description": "\u5f00\u542f\u9a8c\u8bc1\u7801\u65f6\u5fc5\u586b",
                    "example": "6"
                  },
                  "uuid": {
                    "type": "string",
                    "description": "\u5f00\u542f\u9a8c\u8bc1\u7801\u65f6\u5fc5\u586b\uff0c\u6765\u81eacaptchaImage",
                    "example": "12345678123456781234567812345678",
                    "pattern": "^[a-fA-F0-9]{32}$"
                  }
                },
                "description": "\u9a8c\u8bc1\u7801\u5f00\u5173\u4e3atrue\u65f6code\u4e0euuid\u5fc5\u586b\uff0c\u4e3afalse\u65f6\u53ef\u7701\u7565\uff1b\u5bc6\u7801\u4e0d\u8fdb\u884ctrim\u5904\u7406\u3002"
              },
              "example": {
                "username": "admin",
                "password": "REPLACE_WITH_YOUR_PASSWORD",
                "code": "6",
                "uuid": "12345678123456781234567812345678"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "\u767b\u5f55\u6210\u529f\uff0ctoken\u4f4d\u4e8e\u9876\u5c42",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "msg",
                    "token"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "description": "\u6210\u529f200\uff0c\u5931\u8d25\u5bf9\u5e94HTTP\u72b6\u6001\u7801",
                      "example": 200
                    },
                    "msg": {
                      "type": "string",
                      "example": "\u64cd\u4f5c\u6210\u529f"
                    },
                    "token": {
                      "type": "string",
                      "description": "JWT\u4ee4\u724c\uff0c\u53d6\u9876\u5c42token\uff0c\u4e0d\u662fdata.token\u3002"
                    }
                  },
                  "description": "\u82e5\u4f9d\u901a\u7528\u54cd\u5e94\u3002\u767b\u5f55Token\u3001\u5f53\u524d\u7528\u6237\u548c\u6743\u9650\u5b57\u6bb5\u4f4d\u4e8e\u9876\u5c42\uff1b\u8def\u7531\u6570\u7ec4\u4f4d\u4e8edata\u3002"
                },
                "example": {
                  "code": 200,
                  "msg": "\u64cd\u4f5c\u6210\u529f",
                  "token": "<JWT\u4ee4\u724c>"
                }
              }
            }
          },
          "400": {
            "description": "\u53c2\u6570\u6216\u9a8c\u8bc1\u7801\u9519\u8bef",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "msg"
                  ],
                  "properties": {
